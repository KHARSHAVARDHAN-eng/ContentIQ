# ==============================================================================
# contentIQ - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in production environment dashboards (Render, Vercel, etc.)
# Do not commit your actual production secrets to Git!

# ------------------------------------------------------------------------------
# 1. FASTAPI BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
PROJECT_NAME=contentIQ
API_V1_STR=/api
SECRET_KEY=generate_a_long_random_jwt_signing_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection (PostgreSQL)
# Supports both postgres:// and postgresql:// dialects (Render automatically formats this)
DATABASE_URL=postgresql://user:password@your-database-host:5432/your-db-name

# CORS Configuration
# Comma-separated list of allowed origins. Set to your production Vercel URL.
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3002

# ------------------------------------------------------------------------------
# 2. QDRANT VECTOR DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Qdrant Cloud (Recommended for Production)
QDRANT_URL=https://your-qdrant-cluster-url.aws.qdrant.io:6333
QDRANT_API_KEY=your-secure-qdrant-cloud-api-key-here

# For Private Service / Self-Hosted (fallback - leave QDRANT_URL empty)
QDRANT_HOST=
QDRANT_PORT=6333

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI API
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. CLOUD STORAGE CONFIGURATION (S3-Compatible / Supabase Storage / S3)
# ------------------------------------------------------------------------------
# Set to "s3" to enable Cloud uploads, or "local" to store files on the server disk
STORAGE_TYPE=s3

# S3 Access Keys (e.g. AWS or Supabase S3 credentials)
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key

# S3 Endpoint URL (Required for Supabase Storage, leave empty for standard AWS S3)
# Supabase example: https://yourprojectid.supabase.co/storage/v1/s3
AWS_S3_ENDPOINT_URL=https://yourprojectid.supabase.co/storage/v1/s3
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_REGION_NAME=us-east-1

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Vercel Dashboard env var)
# ------------------------------------------------------------------------------
# Set this variable in the Vercel dashboard environment settings
VITE_API_URL=https://your-backend.onrender.com/api
