PROJECT_NAME=DocumentIQ
API_V1_STR=/api
SECRET_KEY=supersecretjwtkeychangeinproduction123456789
ACCESS_TOKEN_EXPIRE_MINUTES=60
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documentiq
DATABASE_URL=postgresql://postgres:postgres@db:5432/documentiq

# Qdrant Vector Database
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_PATH=./qdrant_data

# Gemini API
GEMINI_API_KEY=

# Context Compression Configuration
CONTEXT_COMPRESSION_ENABLED=True
MAX_CONTEXT_TOKENS=2048
MAX_CONTEXT_CHUNKS=10
REDUNDANCY_THRESHOLD=0.85
SENTENCE_SIMILARITY_THRESHOLD=0.85
LOW_INFORMATION_THRESHOLD=15
PRESERVE_CITATIONS=True
CONTEXT_COMPRESSION_DEBUG=True

# Answer Verification Configuration
ANSWER_VERIFICATION_ENABLED=True
CLAIM_EXTRACTION_ENABLED=True
MIN_VERIFICATION_SCORE=0.70
VERIFICATION_CONFIDENCE_THRESHOLD=0.80
MAX_CLAIMS_PER_RESPONSE=8
ANSWER_VERIFICATION_DEBUG=True

# Self-Reflection Configuration
SELF_REFLECTION_ENABLED=True
SELF_REFLECTION_MODE=analysis
ENABLE_ANSWER_REFINEMENT=True
MAX_REFLECTION_ITERATIONS=1
REFLECTION_SCORE_THRESHOLD=0.80
REFLECTION_DEBUG=True

# Confidence Scoring Configuration
CONFIDENCE_SCORING_ENABLED=True
CONFIDENCE_HIGH_THRESHOLD=80.0
CONFIDENCE_MEDIUM_THRESHOLD=50.0
CONFIDENCE_LOW_THRESHOLD=50.0
CONFIDENCE_DEBUG=True
CONFIDENCE_WEIGHT_RETRIEVAL=0.15
CONFIDENCE_WEIGHT_RERANKING=0.15
CONFIDENCE_WEIGHT_VERIFICATION=0.20
CONFIDENCE_WEIGHT_HALLUCINATION=0.20
CONFIDENCE_WEIGHT_REFLECTION=0.15
CONFIDENCE_WEIGHT_CITATIONS=0.15

# RAG Evaluation Configuration
EVALUATION_ENABLED=True
AUTO_EVALUATE_RESPONSES=True
BENCHMARK_DATASET_ENABLED=True
SAVE_EVALUATION_RESULTS=False
MIN_ACCEPTABLE_SCORE=0.70
EVALUATION_DEBUG=True
EVAL_WEIGHT_FAITHFULNESS=0.25
EVAL_WEIGHT_RELEVANCY=0.20
EVAL_WEIGHT_CONTEXT_PRECISION=0.15
EVAL_WEIGHT_CONTEXT_RECALL=0.15
EVAL_WEIGHT_CITATION_COVERAGE=0.15
EVAL_WEIGHT_VERIFICATION_SUCCESS=0.10

# Agentic RAG Configuration
AGENTIC_RAG_ENABLED=False
AGENTIC_MAX_REASONING_STEPS=3
AGENTIC_MAX_RETRIEVAL_ATTEMPTS=3
AGENTIC_EVALUATION_THRESHOLD=0.75
AGENTIC_DEBUG=True

# GraphRAG Configuration
GRAPHRAG_ENABLED=True
GRAPHRAG_STORAGE_PATH=graph_store.json
GRAPHRAG_EXTRACTION_LIMIT=15
GRAPHRAG_CONFIDENCE_THRESHOLD=0.50
GRAPHRAG_TRAVERSAL_DEPTH=2
GRAPHRAG_HYBRID_WEIGHT=0.30
